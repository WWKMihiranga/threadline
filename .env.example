# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Neon): use the pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signs admin session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app (used for PayHere return/cancel/notify URLs)
APP_URL="http://localhost:3000"

# PayHere sandbox (https://sandbox.payhere.lk → Settings → Domains & Credentials)
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"

# Business WhatsApp number, international format without "+"
WHATSAPP_NUMBER="94771234567"

# Uploadthing (https://uploadthing.com → API Keys)
UPLOADTHING_TOKEN=""

# Used only by `npx prisma db seed` to create the first admin
ADMIN_EMAIL="admin@threadline.lk"
ADMIN_PASSWORD=""
